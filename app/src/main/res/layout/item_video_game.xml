<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/game_rent_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/image_game"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/photo_preview_accessibility"
        android:scaleType="centerCrop"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/text_game_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/game_rent_text"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/text_game_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/game_rent_secondary_text" />
        <TextView
            android:id="@+id/text_game_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/game_rent_text" />
        <TextView
            android:id="@+id/text_game_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/game_rent_accent" />
        <TextView
            android:id="@+id/text_game_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video"
            android:textColor="@color/game_rent_secondary_text"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <Button
            android:id="@+id/button_edit_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/edit_game" />
        <Button
            android:id="@+id/button_delete_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/delete_game" />
    </LinearLayout>
</LinearLayout>
